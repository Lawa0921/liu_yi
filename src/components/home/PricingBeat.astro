---
// 課表（beat: pricing；網址錨點 #schedule）：光點聚成一卷攤開的竹簡（簿冊、紀錄的意象，不是錢幣），亮度比人形低——光點退成背景的氣，資訊清楚浮在上面。
// 竹簡放在文字之外（橫向在右、直向在上）；沒有任何字。靜態圖（減少動態、沒有 WebGL、沒有 JS）就是那一卷竹簡。
// beat id 與 class 仍叫 pricing（光點引擎的內部識別字）。不放任何金額或時段：課表只有業主的海報圖，不轉成文字，避免抄錯（設計 §7）；
// 收費方案不公開（業主決定），想知道費用的人用「費用洽詢」開 LINE。
import Still from './Still.astro';
import { url } from '../../lib/url';
import { BOOKING_ANCHOR } from '../../lib/site';
import { COPY } from '../../qi/config/copy';
---

<section id="schedule" class="beat beat--plain beat--pricing" data-beat="pricing" aria-labelledby="schedule-heading">
  <div class="beat__panel beat__panel--plain">
    <div class="beat__text">
      <h2 id="schedule-heading" class="beat__heading">課表</h2>
      <p class="beat__lead">{COPY.pricing.lead}</p>
      <p class="beat__lead">{COPY.pricing.ask}</p>
      <ul class="pricing__links">
        <li><a class="button" href={url('/schedule/')}>看課表</a></li>
        <li><a class="button" href={BOOKING_ANCHOR} data-line-open>費用洽詢</a></li>
      </ul>
      <p class="pricing__facility">
        <span>{COPY.pricing.facility}</span>
        <a class="text-link beat__link" href={url('/facility/')}>看場地</a>
      </p>
    </div>
    <Still name="scroll" />
  </div>
</section>
