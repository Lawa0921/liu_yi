---
// 課程段的一個 beat：一個姿勢、兩個對象的面板。
//   - 每個分類的第一個 beat（lead）放課程本身：標題、兩行介紹（summary ＋一行招式註解）、「看這門課」。
//   - 其餘 beat 只放招式註解（格鬥的第二式、兵器的第二、三件）。
//   - 兵器的三個 beat 各有一個 [data-sub-item]（中國劍／苗刀／大槍＋一行）；最後一件另有「看真兵器」，連到該對象自己的兵器課（大人＝中式兵器，小孩＝防身兵器）。
// 招式註解：大人取自 copy.ts；小孩的課程首句取自課程內文（例如防身格鬥的「戴上拳套，學會出手，也學會收手。」）。
// 某對象沒有這個分類的課時，該對象的面板只剩靜態圖（RF4）。
// 只屬於某一個對象的 beat（poses.ts 的 BEAT_ONLY_FOR，例如大人沒有的格鬥第二式）：只輸出那個對象的面板，段落標 data-beat-only，
// 另一個對象的頁面上整段 display: none（home.css），高度 0，捲動模型跳過它。
import MoveBlock from './MoveBlock.astro';
import Still from './Still.astro';
import { AUDIENCES, AUDIENCE_LABEL, type Audience } from '../../lib/courses';
import type { Course } from '../../lib/content';
import { firstSentence, type StepModel } from '../../lib/home';
import { url } from '../../lib/url';
import { BEAT_NO, COPY } from '../../qi/config/copy';
import { BEAT_ONLY_FOR, beatShownFor, poseFor, type BeatId } from '../../qi/config/poses';

interface Props {
  /** 課程段的 beat（fist、combat-a、combat-b、weapon-a、weapon-b、weapon-c）。 */
  beat: BeatId;
  step: StepModel<Course>;
  lead: boolean;
}

const { beat, step, lead } = Astro.props;

const WEAPONS = {
  'weapon-a': { kind: 'jian', index: 0 },
  'weapon-b': { kind: 'miaodao', index: 1 },
  'weapon-c': { kind: 'spear', index: 2 },
} as const;
const weapon = beat in WEAPONS ? WEAPONS[beat as keyof typeof WEAPONS] : undefined;

interface Move {
  no: string;
  name: string;
  lines: string[];
}

function moveFor(audience: Audience, course: Course): Move | undefined {
  if (weapon) {
    const item = course.data.subItems[weapon.index];
    // 小孩版（Task 27 追加）：兵器三段都有小孩持械的姿勢與一句小孩語氣的說明（COPY.moves 的 kid-weapon／kid-miaodao／kid-spear）；名稱仍是課程子項的名稱
    const line = audience === 'kid' ? COPY.moves[poseFor(beat, 'kid')]?.lines[0] : undefined;
    const no = BEAT_NO[audience][beat as keyof typeof WEAPONS];
    return item && no ? { no, name: item.name, lines: [line ?? COPY.weapons[weapon.kind]] } : undefined;
  }
  const copy = COPY.moves[poseFor(beat, audience)];
  if (!copy) return undefined;
  const first = audience === 'kid' && lead ? firstSentence(course.body) : '';
  const rest = first ? [] : copy.lines.slice(1);
  return { no: copy.no, name: copy.name, lines: [first || copy.lines[0], ...rest].filter((line): line is string => Boolean(line)) };
}

const panels = AUDIENCES.filter((audience) => beatShownFor(beat, audience)).map((audience) => {
  const course = step[audience];
  return { audience, course, move: course ? moveFor(audience, course) : undefined, still: poseFor(beat, audience) };
});
const only = BEAT_ONLY_FOR[beat];
---

<div class="beat beat--course" data-beat={beat} data-beat-only={only}>
  {
    panels.map(({ audience, course, move, still }) => (
      <div class="beat__panel" data-audience-panel={audience}>
        <div class="beat__text">
          <p class="beat__audience">{AUDIENCE_LABEL[audience]}</p>
          {lead && course && (
            <article class="beat__course" data-course={course.id}>
              <h3 class="beat__title" data-course-title>
                {course.data.title}
              </h3>
              <p class="beat__summary">{course.data.summary}</p>
              {move && <MoveBlock {...move} subItem={Boolean(weapon)} />}
              <a class="text-link beat__link" href={url(`/courses/${course.id}/`)}>
                看這門課<span class="visually-hidden">：{course.data.title}</span>
              </a>
            </article>
          )}
          {!lead && move && <MoveBlock {...move} solo subItem={Boolean(weapon)} />}
          {beat === 'weapon-c' && course && (
            <p class="beat__more">
              <a class="text-link beat__link" href={url(`/courses/${course.id}/`)}>
                看真兵器
              </a>
            </p>
          )}
        </div>
        <Still name={still} />
      </div>
    ))
  }
</div>
