---
// 開場（beat: opening）：直書站名「六藝武術」、副標、靜態海報（聚合態的拳師）、略過鈕與往下捲提示。
//
// 海報是「光點引擎到達之前」的首屏（設計 §8.4）：建置時渲好的 WebP，寬螢幕用 hero-wide、直式螢幕用 hero-tall，
// 高優先載入。引擎接手後交叉淡化（Task 19）；減少動態或沒有 WebGL 時它就是這一段的畫面。
// 版面方向：橫向（寬高比 > 4:5）文字在左、光點在右；直向文字在下、光點在上（取景對應引擎的 look 位移，見 home.css）。
// <source media> 與版面、引擎取景同一個切換點（`engine/viewport.ts` 的 `PORTRAIT_ASPECT`）。
import { SITE } from '../../lib/site';
import { stillInfo } from '../../lib/stills';
import { COPY } from '../../qi/config/copy';
import { PORTRAIT_ASPECT } from '../../qi/engine/viewport';

const wide = stillInfo('hero-wide');
const tall = stillInfo('hero-tall');
---

<section id="opening" class="opening" data-beat="opening" aria-labelledby="opening-title">
  <picture class="opening__poster" aria-hidden="true">
    <source media={`(max-aspect-ratio: ${PORTRAIT_ASPECT})`} srcset={tall.src} width={tall.width} height={tall.height} />
    <img src={wide.src} width={wide.width} height={wide.height} alt="" fetchpriority="high" decoding="async" />
  </picture>

  <div class="opening__lockup">
    <h1 id="opening-title" class="opening__title">{SITE.shortName}</h1>
    <p class="opening__sub">{COPY.opening.sub}</p>
  </div>

  {/* 開場動畫演出時才顯示（Task 19 接線）；沒有 JS 或沒有開場時一直是隱藏的。 */}
  <button type="button" class="opening__skip" data-skip-intro hidden>略過</button>

  <p class="opening__hint">
    <span>{COPY.opening.hint}</span>
    <span class="opening__hint-line" aria-hidden="true"></span>
  </p>
</section>
