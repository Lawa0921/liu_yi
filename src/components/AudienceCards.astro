---
// 「大人｜小孩」切換＋三張課程卡（兵器、拳術、格鬥各一）。首頁與課程總覽共用。
//
// 兩組卡片都輸出在 HTML 裡，顯示哪一組由 <html data-audience> 決定（BaseLayout 的行內腳本與
// src/scripts/audience-toggle.ts 設定）。沒有 JavaScript 時 <html> 沒有 data-audience，兩組都顯示。
//
// 切換的動態：金色滑塊滑到選中的那一邊；新的一組卡片從滑塊移動的方向依序滑入
// （切到小孩由右進、切回大人由左進）。全是 CSS，由 display 的切換觸發，只動 transform／opacity。
import CourseCard from './CourseCard.astro';
import { AUDIENCES, AUDIENCE_LABEL, cardsFor } from '../lib/courses';
import { DEFAULT_AUDIENCE } from '../lib/audience';
import type { Course } from '../lib/content';

interface Props {
  courses: Course[];
}

const { courses } = Astro.props;
---

<div class="audience-cards">
  <div class="audience-cards__controls" role="group" aria-label="選擇課程對象" data-requires-js>
    <span class="audience-cards__thumb" aria-hidden="true"></span>
    {
      AUDIENCES.map((audience) => (
        <button
          type="button"
          class="audience-cards__option"
          data-audience-option={audience}
          aria-pressed={audience === DEFAULT_AUDIENCE ? 'true' : 'false'}
        >
          {AUDIENCE_LABEL[audience]}
        </button>
      ))
    }
  </div>

  {
    AUDIENCES.map((audience) => (
      <div class="audience-cards__panel" data-audience-panel={audience}>
        <p class="audience-cards__panel-label">
          <span class:list={['seal', 'seal--pair', { 'seal--cool': audience === 'kid' }]}>
            <span>{AUDIENCE_LABEL[audience]}</span>
          </span>
          <span class="rule rule--faint" aria-hidden="true" />
        </p>
        <ul class="audience-cards__list">
          {cardsFor(courses, audience).map((course, index) => (
            <li style={`--i:${index}`}>
              <CourseCard course={course} />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style is:global>
  /* 依 <html data-audience> 隱藏另一組。寫成 global 是因為選擇器從 <html> 開始。 */
  html[data-audience='adult'] [data-audience-panel='kid'],
  html[data-audience='kid'] [data-audience-panel='adult'] {
    display: none;
  }

  /* 沒有 JS 時兩組都顯示，中間才需要間距；有切換時只有一組，不能留間距（否則切換會上下跳）。 */
  html:not([data-audience]) .audience-cards__panel + .audience-cards__panel {
    margin-top: var(--space-7);
  }

  /* 有切換按鈕時不需要每組上面的「大人／小孩」標籤。 */
  html[data-audience] .audience-cards__panel-label {
    display: none;
  }

  /* 滑塊與選中的字色跟著 <html data-audience> 走（首次繪製前就設好，不會閃）。 */
  html[data-audience='kid'] .audience-cards__thumb {
    transform: translate3d(100%, 0, 0);
  }

  html[data-audience='adult'] [data-audience-option='adult'],
  html[data-audience='kid'] [data-audience-option='kid'] {
    color: var(--color-on-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    html.js [data-audience-panel] .audience-cards__list > li {
      animation: audience-card-in 0.85s var(--ease-out) both;
      animation-delay: calc(var(--i) * 0.1s);
    }

    html.js [data-audience-panel='kid'] .audience-cards__list > li {
      animation-name: audience-card-in-kid;
    }
  }

  @keyframes audience-card-in {
    from {
      opacity: 0;
      transform: translate3d(-2.5rem, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes audience-card-in-kid {
    from {
      opacity: 0;
      transform: translate3d(2.5rem, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  .audience-cards {
    display: grid;
    justify-items: center;
  }

  .audience-cards__controls {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: var(--space-7);
    padding: 4px;
    border: var(--line) solid var(--color-line);
  }

  .audience-cards__controls::before {
    content: '';
    position: absolute;
    inset: -5px;
    border: var(--line) solid var(--color-line-faint);
    pointer-events: none;
  }

  .audience-cards__thumb {
    position: absolute;
    inset: 4px auto 4px 4px;
    width: calc(50% - 4px);
    background: var(--color-accent);
    transition: transform 0.55s var(--ease-out);
  }

  .audience-cards__option {
    position: relative;
    min-width: 8.5rem;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-5);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    cursor: pointer;
    transition: color 0.4s;
  }

  .audience-cards__option:hover {
    color: var(--color-text);
  }

  .audience-cards__panel {
    width: 100%;
    /* 卡片從側邊滑入時不能把頁面撐寬（手機會出現水平捲軸）；留 8px 給卡片角飾 hover 時外推。 */
    overflow: clip;
    overflow-clip-margin: 8px;
  }

  .audience-cards__panel-label {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .audience-cards__panel-label .rule {
    flex: 1;
  }

  .audience-cards__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 一次三張並排。 */
  @media (min-width: 48rem) {
    .audience-cards__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 30rem) {
    .audience-cards__option {
      min-width: 7rem;
    }
  }
</style>
