---
// 文字海報（收費、課表、教練海報）：像一幅掛軸——上下各一根軸桿，中間是海報。
// 點擊在站內的放大視窗開啟原尺寸圖（src/components/PosterDialog.astro＋src/scripts/poster-lightbox.ts）；
// 沒有 JS 時這個連結照常連到圖檔本身。
import { Image, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** 圖說，同時是「放大」連結的名稱。 */
  caption: string;
  /** 首屏的圖傳 true，其他延後載入。 */
  eager?: boolean;
}

const { src, alt, caption, eager = false } = Astro.props;
const full = await getImage({ src, width: src.width });
---

<figure class="poster">
  <a
    class="poster__link"
    href={full.src}
    aria-label={`放大檢視：${caption}`}
    data-poster
    data-poster-alt={alt}
    data-poster-width={full.attributes.width}
    data-poster-height={full.attributes.height}
  >
    <span class="poster__rod" aria-hidden="true"></span>
    <span class="poster__sheet">
      <Image
        src={src}
        alt={alt}
        width={Math.min(src.width, 900)}
        sizes="(min-width: 60rem) 34rem, 95vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
      <span class="poster__zoom" aria-hidden="true">點圖放大</span>
    </span>
    <span class="poster__rod" aria-hidden="true"></span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .poster {
    margin: 0;
    width: 100%;
    max-width: 36rem;
  }

  .poster__link {
    display: block;
    padding-inline: 0.875rem;
    color: inherit;
    text-decoration: none;
    cursor: zoom-in;
  }

  /* 軸桿：比畫心寬一點，兩端有軸頭。 */
  .poster__rod {
    position: relative;
    display: block;
    height: 9px;
    margin-inline: -0.875rem;
    background: linear-gradient(var(--color-accent-strong), var(--color-accent) 45%, color-mix(in srgb, var(--color-accent) 55%, var(--color-void)));
  }

  .poster__rod::before,
  .poster__rod::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 7px;
    height: 15px;
    background: var(--color-accent-strong);
  }

  .poster__rod::before {
    left: -7px;
  }

  .poster__rod::after {
    right: -7px;
  }

  .poster__sheet {
    position: relative;
    display: block;
    overflow: hidden;
    border-inline: var(--line) solid var(--color-line);
    background: var(--color-surface);
  }

  .poster__sheet :global(img) {
    width: 100%;
    transition: transform 1.2s var(--ease-out);
  }

  .poster__link:hover .poster__sheet :global(img) {
    transform: scale(1.02);
  }

  .poster__zoom {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: var(--line) solid var(--color-accent);
    background: var(--color-veil);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
  }

  .poster figcaption {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.3em;
    text-align: center;
  }
</style>
