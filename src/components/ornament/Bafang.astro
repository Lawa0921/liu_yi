---
// 八方：八角構圖與八向放射線（八極的「八方」意象）。自繪向量，純紋飾，不含任何文字或卦象。
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const C = 400;
const point = (radius: number, degrees: number) => {
  const angle = (degrees * Math.PI) / 180;
  return `${(C + Math.cos(angle) * radius).toFixed(1)} ${(C + Math.sin(angle) * radius).toFixed(1)}`;
};
const octagon = (radius: number, offset: number) =>
  `M${Array.from({ length: 8 }, (_, i) => point(radius, offset + i * 45)).join('L')}Z`;

const rays = Array.from({ length: 8 }, (_, i) => `M${point(96, i * 45)}L${point(352, i * 45)}`).join('');
// 每道放射線上的三個刻度。
const ticks = Array.from({ length: 8 }, (_, i) =>
  [160, 224, 288]
    .map((radius) => {
      const spread = (Math.atan(7 / radius) * 180) / Math.PI;
      return `M${point(radius, i * 45 - spread)}L${point(radius, i * 45 + spread)}`;
    })
    .join(''),
).join('');
// 八個角上的小方點。
const studs = Array.from({ length: 8 }, (_, i) => point(366, 22.5 + i * 45));
---

<svg class:list={["line-art", className]} viewBox="0 0 800 800" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false">
  <path d={octagon(396, 22.5)} />
  <path d={octagon(380, 22.5)} opacity="0.5" />
  <path d={octagon(352, 0)} opacity="0.75" />
  <path d={rays} />
  <path d={ticks} opacity="0.7" />
  <path d={octagon(96, 22.5)} />
  <path d={octagon(72, 0)} opacity="0.5" />
  <circle cx="400" cy="400" r="5" fill="currentColor" stroke="none" />
  {studs.map((p) => <circle cx={p.split(' ')[0]} cy={p.split(' ')[1]} r="2.5" fill="currentColor" stroke="none" />)}
</svg>
