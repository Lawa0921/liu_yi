---
// 首頁三幕：兵器、拳術、格鬥。每一幕是一個 <section data-act="weapon|fist|combat">：
//   巨大的襯線單字（兵／拳／搏）、直書的分類名、該幕的紋樣（兵器輪廓／八方／擂台）、
//   以及一對直書「牌」——大人與小孩那兩門課的連結。
//
// 大人三門課沒有實拍照（設計文件 §6「缺照片時」），所以每一幕以字體與紋樣為主體；
// 兒童照只放在標明「小孩」的那張牌上，不拿來代表大人課程。
//
// 動態（src/scripts/acts.ts）：
//   桌機且沒有要求減少動態 → GSAP ScrollTrigger 把每一幕釘在外框裡，隨捲動推進（GSAP 只在這裡載入）；
//   手機、減少動態 → 不釘選，一般捲動；手機另有簡單的進場效果。
//   沒有 JS → 就是這份靜態版面，內容全在。
//
// 第二版（設計文件 §15.2）：
//   兵器那一幕是「兵器台」：.armory 是 3D 兵器的宿主（src/scripts/weapons3d.ts 接近時才載入 three），
//   線稿（.weapon3d-fallback）留作沒有 WebGL／沒有 JS 時的退路；切換列只在 3D 就緒後出現。
//   拳術那一幕有「震腳」按鈕（src/scripts/stomp.ts；減少動態時不出現）。
import { Image } from 'astro:assets';
import Scene from './Scene.astro';
import Weapon from './ornament/Weapon.astro';
import Bafang from './ornament/Bafang.astro';
import Leitai from './ornament/Leitai.astro';
import { AUDIENCE_LABEL, CATEGORY_GLYPH, CATEGORY_LABEL, pairByCategory } from '../lib/courses';
import type { Course } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  courses: Course[];
}

const acts = pairByCategory(Astro.props.courses);

const ARMORY = [
  { kind: 'jian', label: '劍' },
  { kind: 'miaodao', label: '苗刀' },
  { kind: 'spear', label: '大槍' },
] as const;
---

<div class="acts">
  {
    acts.map(({ category, adult, kid }) => (
      <section
        class="act"
        data-act={category}
        data-weapon3d-scope={category === 'weapon' ? '' : undefined}
        aria-labelledby={`act-${category}`}
      >
        {category === 'weapon' && <Scene scene="weapon" />}
        {category === 'fist' && <Scene scene="fist" />}
        {category === 'combat' && <Scene scene="combat" />}
        <div class="act__stage">
          <div class="act__motif" aria-hidden="true">
            {category === 'weapon' && (
              <>
                <Weapon kind="spear" class="act__weapon act__weapon--spear weapon3d-fallback" />
                <Weapon kind="miaodao" class="act__weapon act__weapon--miaodao weapon3d-fallback" />
                <Weapon kind="jian" class="act__weapon act__weapon--jian weapon3d-fallback" />
              </>
            )}
          </div>

          {category === 'weapon' && <div class="armory" data-weapon3d="stage" data-weapon-kind="jian" />}
          {/* 兵器前面的一層塵（疊在 3D 畫布上面；背後那層在場景裡）。 */}
          {category === 'weapon' && <span class="act__impact act__dust-front" data-scene-dust aria-hidden="true" />}

          <p class="act__glyph" aria-hidden="true">
            {category === 'fist' && <Bafang class="act__emblem" />}
            {category === 'combat' && <Leitai class="act__emblem" />}
            <span>{CATEGORY_GLYPH[category]}</span>
          </p>

          <div class="act__head">
            <h2 class="act__title" id={`act-${category}`}>
              {CATEGORY_LABEL[category]}
            </h2>
            <span class="act__title-line" aria-hidden="true" />
          </div>

          {category === 'weapon' && (
            <div class="armory-bar" data-weapon3d-controls>
              <div class="armory-switch" role="group" aria-label="選擇兵器">
                {/* 刀鋒指示條：滑到選中的那一件，身後留一道殘光（src/scripts/armory-blade.ts）。 */}
                <span class="armory-switch__blade" aria-hidden="true" />
                {ARMORY.map(({ kind, label }, index) => (
                  <button
                    type="button"
                    class="armory-switch__option"
                    data-weapon-pick={kind}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {label}
                  </button>
                ))}
              </div>
              <span class="armory-bar__hint">拖曳轉動</span>
            </div>
          )}

          {category === 'fist' && <canvas class="act__impact" data-impact aria-hidden="true" />}

          {category === 'fist' && (
            <div class="act__moves">
              <button type="button" class="act__stomp" data-stomp hidden>
                <span class="seal seal--pair">
                  <span>震腳</span>
                </span>
                <span class="act__stomp-hint">點一下</span>
              </button>
              <button type="button" class="act__stomp" data-kao hidden>
                <span class="seal seal--pair seal--trio">
                  <span>貼山靠</span>
                </span>
              </button>
            </div>
          )}

          <ul class="act__courses">
            {[adult, kid].map(
              (course) =>
                course && (
                  <li class="act__course">
                    <a
                      class:list={['tablet', 'cornered', course.data.photos[0] ? 'tablet--photo' : 'tablet--plain']}
                      href={url(`/courses/${course.id}/`)}
                    >
                      <i class="cornered__tick" />
                      <i class="cornered__tick" />
                      <i class="cornered__tick" />
                      <i class="cornered__tick" />
                      {course.data.photos[0] ? (
                        <span class="tablet__photo">
                          <Image
                            src={course.data.photos[0].src}
                            alt={course.data.photos[0].alt}
                            width={520}
                            height={390}
                            fit="cover"
                            sizes="(min-width: 60rem) 15rem, 45vw"
                            loading="lazy"
                          />
                        </span>
                      ) : (
                        <span class="tablet__lattice lattice" aria-hidden="true" />
                      )}
                      <span class:list={['seal', 'seal--pair', 'tablet__seal', { 'seal--cool': course.data.audience === 'kid' }]}>
                        <span>{AUDIENCE_LABEL[course.data.audience]}</span>
                      </span>
                      <span class="tablet__name">{course.data.title}</span>
                      <span class="tablet__summary">{course.data.summary}</span>
                      <span class="tablet__go" aria-hidden="true">
                        看這門課
                      </span>
                    </a>
                  </li>
                ),
            )}
          </ul>
        </div>
      </section>
    ))
  }
</div>

<script>
  import { initActs } from '../scripts/acts';
  import { initArmoryBlade } from '../scripts/armory-blade';
  import { initStomp } from '../scripts/stomp';

  initActs();
  initStomp();
  initArmoryBlade();
</script>

<style>
  .acts {
    position: relative;
  }

  /* 章節色（第三版）：各幕一個主色，兵器幕再跟著台上的兵器換。只用在幾處細節（直線、選中的底線），克制。 */
  .act {
    --chapter: var(--color-accent);
    transition: --chapter 0.7s var(--ease-out);
  }

  .act[data-act='fist'] {
    --chapter: var(--color-seal-strong);
  }

  .act[data-chapter='jian'] {
    --chapter: var(--color-patina);
  }

  .act[data-chapter='miaodao'] {
    --chapter: var(--color-iron);
  }

  .act {
    position: relative;
    overflow: hidden;
    border-top: var(--line) solid var(--color-line-faint);
  }

  /* 後兩幕（拳術、格鬥）還沒捲到附近時不排版內容：它們的字型分包與照片等捲近了才下載（首屏傳輸量）。
     幕本身的框大小不變（桌機是固定高度），釘選的量測不受影響。 */
  .act[data-act='fist'],
  .act[data-act='combat'] {
    content-visibility: auto;
    contain-intrinsic-size: auto 100svh;
  }

  .act__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'glyph head'
      'courses courses';
    align-items: center;
    gap: var(--space-5) var(--space-4);
    padding: var(--space-8) var(--gutter);
  }

  /* ── 紋樣 ─────────────────────────────────────────── */
  .act__motif {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--color-line);
  }

  /* 八方／擂台：以巨大單字為中心。 */
  :global(.act__emblem) {
    --emblem: min(118vw, 34rem);
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--emblem);
    height: var(--emblem);
    max-width: none;
    margin: calc(var(--emblem) / -2) 0 0 calc(var(--emblem) / -2);
    color: var(--color-line);
    opacity: 0.45;
  }

  :global(.act__weapon) {
    position: absolute;
    left: -8%;
    width: 150%;
    max-width: none;
    opacity: 0.6;
  }

  :global(.act__weapon--spear) {
    top: 4.5rem;
    left: -55%;
    transform: rotate(-4deg);
  }

  :global(.act__weapon--miaodao) {
    top: 11rem;
    left: -22%;
    transform: rotate(3deg);
  }

  :global(.act__weapon--jian) {
    top: 19.5rem;
    left: -40%;
    transform: rotate(-2deg);
  }

  /* ── 兵器台（第二版）：3D 兵器疊在巨大單字上面、牌子下面 ── */
  .armory {
    grid-row: 1;
    grid-column: 1 / -1;
    align-self: stretch;
    position: relative;
    z-index: 1;
    /* 手機：畫布左右貼齊幕的邊，往上蓋到幕頂。 */
    margin: calc(var(--space-8) * -1) calc(var(--gutter) * -1) 0;
  }

  /* 3D 兵器的位置先留好（有 JS 就會嘗試載入 3D）：不然 3D 就緒的那一刻整幕突然長高，下面的內容往下跳。
     退回線稿（fallback）時才把位置收回來。 */
  :global(html.js) .armory:not([data-weapon3d-state='fallback']) {
    min-height: min(27rem, 112vw);
  }

  /* 3D 就緒：3D 兵器是主角。背景大字與持械人形只留其一——有人形就把大字收掉。 */
  .act[data-weapon3d-state='ready'] .act__glyph {
    opacity: 0.1;
  }

  .act[data-weapon3d-state='ready']:has([data-scene-figure]) .act__glyph {
    opacity: 0;
  }

  .armory-bar {
    grid-area: bar;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  :global(html.js) .act[data-weapon3d-scope]:not([data-weapon3d-state='fallback']) .act__stage {
    grid-template-areas:
      'glyph head'
      'bar bar'
      'courses courses';
  }

  /* 3D 還在載入：切換列先佔好位置（看不見），就緒時才不會把下面的內容往下推。 */
  :global(html.js) .act[data-weapon3d-scope]:not([data-weapon3d-state]) .armory-bar {
    display: flex;
    visibility: hidden;
  }

  .armory-switch {
    position: relative;
    display: flex;
    align-items: stretch;
    border: var(--line) solid var(--color-line-faint);
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .armory-switch__option {
    position: relative;
    min-width: 4rem;
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-indent: 0.24em;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s;
  }

  .armory-switch__option + .armory-switch__option {
    border-inline-start: var(--line) solid var(--color-line-faint);
  }

  /* 選中的那一件：字轉亮，底下一道刃光似的金線。 */
  .armory-switch__option::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--chapter) 30%,
      var(--color-text) 50%,
      var(--chapter) 70%,
      transparent
    );
    transform: scaleX(0);
    transition: transform 0.45s var(--ease-out);
  }

  .armory-switch__option[aria-pressed='true'] {
    color: var(--color-text);
  }

  .armory-switch__option[aria-pressed='true']::after {
    transform: scaleX(1);
  }

  /* 有刀鋒指示條（有 JS）時，由它取代各鈕自己的底線。 */
  .armory-switch:has(.armory-switch__blade[style]) .armory-switch__option::after {
    display: none;
  }

  .armory-switch__blade,
  :global(.armory-switch__trail) {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    pointer-events: none;
  }

  /* 刀鋒：中間近白、兩端收進章節色，像刃口的一道光。 */
  .armory-switch__blade {
    z-index: 2;
    background: linear-gradient(90deg, transparent, var(--chapter) 22%, var(--color-text) 50%, var(--chapter) 78%, transparent);
    transition:
      translate 0.42s cubic-bezier(0.7, 0, 0.2, 1),
      width 0.42s cubic-bezier(0.7, 0, 0.2, 1);
  }

  /* 殘光：從舊的位置拉到新的位置、很快淡掉。 */
  :global(.armory-switch__trail) {
    z-index: 1;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--color-accent-strong) 70%, transparent), transparent);
  }

  .armory-switch__option:hover {
    color: var(--color-accent-strong);
  }

  .armory-bar__hint {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.3em;
    white-space: nowrap;
  }

  /* ── 震腳（第二版） ───────────────────────────────── */
  .act__moves {
    grid-area: glyph;
    align-self: end;
    justify-self: center;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* 衝擊層（裂紋、塵浪、漆片）：鋪滿整幕，不接收指標事件。 */
  .act__impact {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .seal--trio {
    height: 4.1em;
  }

  /* 課程牌被撞時繞上緣晃（像掛著的木牌）。 */
  .act__course {
    transform-origin: 50% 0;
  }

  .act__stomp {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.3em;
    cursor: pointer;
  }

  .act__stomp[hidden] {
    display: none;
  }

  .act__stomp .seal {
    font-size: 1rem;
    transition: transform 0.2s var(--ease-out);
  }

  .act__stomp:hover .seal {
    transform: scale(1.08);
  }

  .act__stomp:active .seal {
    transform: scale(0.92);
  }

  .act__stomp-hint {
    white-space: nowrap;
  }

  /* ── 巨大單字 ─────────────────────────────────────── */
  .act__glyph {
    grid-area: glyph;
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(9rem, 52vw, 15rem);
    font-weight: 700;
    line-height: 1;
  }

  /* 大字是平面的單色（不用漸層、不疊陰影：不做成金色立體字）。 */
  .act__glyph > span {
    position: relative;
    display: inline-block;
    color: var(--color-accent-strong);
  }

  /* ── 直書分類名 ───────────────────────────────────── */
  .act__head {
    grid-area: head;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    align-self: stretch;
    padding-block: var(--space-4);
  }

  .act__title {
    margin: 0;
    writing-mode: vertical-rl;
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    letter-spacing: 0.3em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .act__title-line {
    flex: 1;
    width: 1px;
    min-height: 2.5rem;
    background: linear-gradient(var(--chapter), transparent);
    transform-origin: center top;
  }

  /* ── 一對直書牌 ───────────────────────────────────── */
  .act__courses {
    grid-area: courses;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .act__course {
    display: grid;
  }

  .tablet {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto auto;
    grid-template-areas:
      'photo photo'
      'seal name'
      'summary summary'
      'go go';
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--line) solid var(--color-line-faint);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.4s;
  }

  .tablet:hover {
    border-color: var(--color-line);
    color: var(--color-text);
  }

  .tablet:hover .cornered__tick:nth-of-type(1) {
    transform: translate(-4px, -4px);
  }

  .tablet:hover .cornered__tick:nth-of-type(2) {
    transform: translate(4px, -4px);
  }

  .tablet:hover .cornered__tick:nth-of-type(3) {
    transform: translate(-4px, 4px);
  }

  .tablet:hover .cornered__tick:nth-of-type(4) {
    transform: translate(4px, 4px);
  }

  .tablet__photo {
    grid-area: photo;
    position: relative;
    display: block;
    overflow: hidden;
    margin: calc(var(--space-4) * -1) calc(var(--space-4) * -1) 0;
    aspect-ratio: 4 / 3;
  }

  .tablet__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .tablet:hover .tablet__photo :global(img) {
    transform: scale(1.06);
  }

  .tablet__lattice {
    -webkit-mask-image: var(--pattern-lattice), linear-gradient(#000, transparent 70%);
    mask-image: var(--pattern-lattice), linear-gradient(#000, transparent 70%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    -webkit-mask-size:
      48px 48px,
      100% 100%;
    mask-size:
      48px 48px,
      100% 100%;
  }

  .tablet__seal {
    grid-area: seal;
    align-self: start;
    position: relative;
    font-size: var(--text-sm);
  }

  .tablet__name {
    grid-area: name;
    position: relative;
    justify-self: end;
    writing-mode: vertical-rl;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 7.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .tablet__summary {
    grid-area: summary;
    position: relative;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .tablet__go {
    grid-area: go;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.3em;
    white-space: nowrap;
  }

  .tablet__go::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-accent);
    transform-origin: left center;
    transition: transform 0.6s var(--ease-out);
  }

  .tablet:hover .tablet__go::after {
    transform: scaleX(0.4);
  }

  /* ── 桌機：一幕剛好填滿外框內的畫面 ───────────────── */
  @media (min-width: 60rem) {
    .act {
      height: var(--stage-height);
      min-height: 34rem;
    }

    .act__stage {
      --glyph: min(60vh, 33vw);
      height: 100%;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'glyph head courses';
      gap: clamp(var(--space-5), 3.5vw, var(--space-8));
      padding: var(--space-6) clamp(4.5rem, 7vw, 7.5rem);
    }

    .act__glyph {
      font-size: var(--glyph);
      justify-self: center;
    }

    .act__head {
      align-self: center;
      height: min(58vh, 30rem);
      padding: 0;
    }

    .act__title {
      font-size: clamp(3rem, 7.5vh, 4.5rem);
    }

    .act__courses {
      grid-template-columns: repeat(2, clamp(12.5rem, 16.5vw, 15rem));
      gap: var(--space-5);
      align-self: center;
      height: min(64vh, 33rem);
    }

    .tablet {
      padding: var(--space-5);
    }

    .tablet__photo {
