---
// 教練卡片：文字卡（窗櫺底紋、方印、姓名大字、職稱）。
// 目前沒有單獨的教練照片；教練海報是燒了字的 Canva 海報，裁成縮圖會把字切半，
// 所以卡片不用海報，海報只留在教練個人頁（設計文件 §8）。
// .coach-card 與 h3 是測試的約定，請保留。
import type { Coach } from '../lib/content';
import { url } from '../lib/url';

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const { name, role } = coach.data;
---

<article class="coach-card cornered">
  <a class="coach-card__link" href={url(`/coaches/${coach.id}/`)}>
    <i class="cornered__tick"></i>
    <i class="cornered__tick"></i>
    <i class="cornered__tick"></i>
    <i class="cornered__tick"></i>
    <span class="lattice coach-card__lattice" aria-hidden="true"></span>
    <span class="seal coach-card__seal" aria-hidden="true"><span>師</span></span>
    <h3 class="coach-card__name">{name}</h3>
    <span class="coach-card__line" aria-hidden="true"></span>
    <p class="coach-card__role">{role}</p>
  </a>
</article>

<style>
  .coach-card {
    height: 100%;
    border: var(--line) solid var(--color-line-faint);
    background: radial-gradient(ellipse at 50% 40%, var(--color-surface-raised), var(--color-surface) 75%);
    transition: border-color 0.4s;
  }

  .coach-card:hover,
  .coach-card:focus-within {
    border-color: var(--color-line);
  }

  .coach-card:hover .cornered__tick:nth-of-type(1) {
    transform: translate(-5px, -5px);
  }

  .coach-card:hover .cornered__tick:nth-of-type(2) {
    transform: translate(5px, -5px);
  }

  .coach-card:hover .cornered__tick:nth-of-type(3) {
    transform: translate(-5px, 5px);
  }

  .coach-card:hover .cornered__tick:nth-of-type(4) {
    transform: translate(5px, 5px);
  }

  .coach-card__link {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-3);
    height: 100%;
    min-height: 13.5rem;
    padding: var(--space-7) var(--space-3) var(--space-5);
    overflow: hidden;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .coach-card__lattice {
    -webkit-mask-image: var(--pattern-lattice), radial-gradient(ellipse at center, transparent 30%, #000 85%);
    mask-image: var(--pattern-lattice), radial-gradient(ellipse at center, transparent 30%, #000 85%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    -webkit-mask-size:
      48px 48px,
      100% 100%;
    mask-size:
      48px 48px,
      100% 100%;
    background-color: var(--color-line-faint);
  }

  .coach-card__seal {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-size: 0.8rem;
  }

  .coach-card__name {
    position: relative;
    margin: 0;
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem);
    letter-spacing: 0.14em;
    /* 字距補償，視覺置中。 */
    padding-inline-start: 0.14em;
    line-height: 1.2;
    white-space: nowrap;
    background: linear-gradient(170deg, var(--color-text) 15%, var(--color-accent-strong) 60%, var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transition: transform 0.9s var(--ease-out);
  }

  .coach-card:hover .coach-card__name {
    transform: scale(1.04);
  }

  .coach-card__line {
    position: relative;
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
    transition: transform 0.6s var(--ease-out);
  }

  .coach-card:hover .coach-card__line {
    transform: scaleX(2);
  }

  .coach-card__role {
    position: relative;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    /* 職稱不在詞中間斷行。 */
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .coach-card__role {
      letter-spacing: 0.04em;
    }
  }
</style>
