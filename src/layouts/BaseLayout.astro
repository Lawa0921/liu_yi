---
// 全站共用版型：<head>（SEO、Open Graph、字型）、固定外框、頁首、頁尾、LINE 視窗、海報放大視窗。
// 固定外框（Frame.astro＋Header.astro）包在這裡的 <body> 內，各頁不用管。
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LineDialog from '../components/LineDialog.astro';
import PosterDialog from '../components/PosterDialog.astro';
import Scene from '../components/Scene.astro';
import type { SceneSpec } from '../lib/scene/config';
import Frame from '../components/Frame.astro';
import { AUDIENCE_STORAGE_KEY } from '../lib/audience';
import { SITE } from '../lib/site';
import { url } from '../lib/url';
import logoLarge from '../assets/images/logo_large.jpg';
import logoEmblem from '../assets/images/logo_transparent.png';

interface Props {
  /** 頁面標題；首頁不傳，直接用站名。 */
  title?: string;
  description?: string;
  /** Open Graph 圖；不傳就用獅子 logo。 */
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** 只有首頁傳：<main> 標上 data-home，首頁專用的樣式與腳本以它為界。 */
  home?: boolean;
  /**
   * 子頁頁首的剪影立體場景（Task 27）：傳了就在 <main> 的最前面輸出 `Scene`（內容的 DOM 順序不變）。`kind` 是頁面種類（`data-scene`），
   * `spec` 是配對表給這一頁的四層（`lib/scene/config.ts`），`swap` 是課程總覽滑過課程卡時要換上的人物素材。首頁不傳（有自己的景深層）。
   */
  scene?: { kind: string; spec: SceneSpec; swap?: string[] };
}

const { title, description = SITE.description, ogImage = logoLarge, ogType = 'website', noindex = false, home = false, scene } = Astro.props;

const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// 社群平台不一定吃 WebP／AVIF，OG 圖固定輸出 JPEG 1200×630。
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site).href;

const favicon = await getImage({ src: logoEmblem, width: 96, height: 96, fit: 'cover', format: 'png' });
---

<!doctype html>
<html lang={SITE.lang} data-audience-key={AUDIENCE_STORAGE_KEY} data-base={url('/')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* noindex 的頁面（404）沒有對應的正式網址，不輸出 canonical 與 og:url。 */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0b0a09" />
    <Font cssVariable="--font-twkai" preload />

    {/* 首次繪製前執行：標記有 JS，並還原上次選的「大人｜小孩」，避免卡片閃一下。
        首頁另外在這裡判定要不要退回靜態圖（html.qi-static）：偏好減少動態，或取不到 WebGL2。靜態圖要不要顯示只由 CSS 決定，
        所以必須在首繪前定案，不能等光點引擎的腳本載入（決定 D20）。其他頁面不探測（建立 WebGL context 有成本）。
        同一處也標開場館徽：這個工作階段已看過開場（再訪）就不會演，館徽一開始就直接顯示終態（html[data-qi-crest="shown"]，不擦出；home.css），
        不等腳本；鍵要與 scripts/home/intro-gate.ts 的 INTRO_STORAGE_KEY 一致（tests/unit/home-crest.test.ts 守住）。
        入館閘門（Task 25）也在這裡、首繪前決定：首頁、沒有減少動態、有 WebGL2、這個工作階段沒進過館、網址沒有 #錨點、不是從站內其他頁來（referrer 在本站 base 底下），
        才標 html[data-gate="open"]（home.css 據此鎖住捲動並顯示閘門）。判斷式與 scripts/home/intro-gate.ts 的 shouldShowGate 是同一條（tests/unit/home-gate-head.test.ts 用 vm 跑這段腳本對照）。
        保險：首頁腳本（scripts/home/gate.ts）接手時設 window.__qiGate；10 秒後還沒接手（腳本載不到），這裡自己拿掉屬性，不讓閘門永遠擋著（GATE_SAFETY_MS）。 */}
    <script is:inline data-probe-engine={home ? '' : undefined}>
      (function () {
        var root = document.documentElement;
        var probeEngine = document.currentScript !== null && document.currentScript.hasAttribute('data-probe-engine');
        root.classList.add('js');
        var stored = null;
        try {
          stored = window.localStorage.getItem(root.dataset.audienceKey || "");
        } catch (e) {}
        root.dataset.audience = stored === 'kid' ? 'kid' : 'adult';

        if (probeEngine) {
          var still = false;
          try {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              still = true;
            } else {
              var probe = document.createElement('canvas');
              var gl = probe.getContext('webgl2');
              if (gl) {
                var lose = gl.getExtension('WEBGL_lose_context');
                if (lose) lose.loseContext();
              } else {
                still = true;
              }
            }
          } catch (e) {
            still = true;
          }
          if (still) root.classList.add('qi-static');
          var visited = false;
          try {
            if (window.sessionStorage.getItem('liuyi:qi-intro') === '1') {
              visited = true;
              root.dataset.qiCrest = 'shown';
            }
          } catch (e) {}
          var hasHash = window.location.hash.length > 1;
          var fromSite = false;
          try {
            fromSite = document.referrer.indexOf(window.location.origin + (root.dataset.base || '/')) === 0;
          } catch (e) {}
          if (!still && !visited && !hasHash && !fromSite) {
            root.dataset.gate = 'open';
            window.setTimeout(function () {
              if (!window.__qiGate) delete root.dataset.gate;
            }, 10000);
          }
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main" data-home={home ? '' : undefined} data-has-scene={scene ? '' : undefined}>
      {scene && <Scene {...scene} />}
      <slot />
    </main>
    <Footer />
    <Frame />
    <LineDialog />
    <PosterDialog />
    {/* 頁面專屬的全屏疊層（首頁的入館閘門）：放在最後，不改變內容的 DOM 順序。 */}
    <slot name="overlay" />

    <script>
      import { initLineDialog, initNavMenu } from '../scripts/site-chrome';
      import { initAudienceToggle } from '../scripts/audience-toggle';
      import { initCardCarousels } from '../scripts/card-carousel';
      import { initLiteVideos } from '../scripts/lite-video';
      import { initReveal } from '../scripts/reveal';
      import { initGalleries } from '../scripts/gallery';
      import { initPosterLightbox } from '../scripts/poster-lightbox';
      import { initWeapons3d } from '../scripts/weapons3d';

      initNavMenu();
      initLineDialog();
      initAudienceToggle();
      initCardCarousels();
      initLiteVideos();
      initReveal();
      initGalleries();
      initPosterLightbox();
      // 頁面上有 3D 兵器的區塊才會有動作；three 本身等接近那個區塊才下載。
      initWeapons3d();
    </script>
  </body>
</html>
