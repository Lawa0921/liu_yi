---
// 首頁「氣聚成人」：金色光點組成的八極拳師當主角，內容跟著招式長出來（設計文件 2026-11-16-qi-homepage-design.md）。
// 段落：開場 → 課程（拳、格鬥、兵器，大人／小孩切換）→ 其他課程 → 師資 → 收費與課表 → 預約。
// 內容全是 DOM 文字；光點引擎畫在固定的 canvas 上（src/scripts/home/init-home.ts 接線），
// 引擎失效或減少動態時，靜態圖就是畫面。
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Opening from '../components/home/Opening.astro';
import CoursesRun from '../components/home/CoursesRun.astro';
import OtherCourses from '../components/home/OtherCourses.astro';
import CoachesBeat from '../components/home/CoachesBeat.astro';
import PricingBeat from '../components/home/PricingBeat.astro';
import BookingBeat from '../components/home/BookingBeat.astro';
import SectionRail from '../components/home/SectionRail.astro';
import Gate from '../components/home/Gate.astro';
import { getPublishedCoaches, getPublishedCourses } from '../lib/content';
import { buildHomeModel } from '../lib/home';

const { steps, others, coaches } = buildHomeModel(await getPublishedCourses(), await getPublishedCoaches());

// 沒有的段落就不輸出，也不進段落導覽（RF4）。
const rail = [
  { id: 'opening', label: '開場' },
  ...(steps.length > 0 ? [{ id: 'courses', label: '課程' }] : []),
  ...(coaches.length > 0 ? [{ id: 'coaches', label: '師資' }] : []),
  { id: 'pricing', label: '收費課表' },
  { id: 'booking', label: '預約' },
];
---

<BaseLayout home>
  {/* 光點畫布：固定在視窗、在所有內容底下；純裝飾，不可聚焦、不進無障礙樹。 */}
  <canvas class="home-canvas" data-qi-canvas aria-hidden="true"></canvas>
  <Opening />
  {steps.length > 0 && <CoursesRun steps={steps} />}
  {others.length > 0 && <OtherCourses courses={others} />}
  {coaches.length > 0 && <CoachesBeat coaches={coaches} />}
  <PricingBeat />
  <BookingBeat />
  <SectionRail items={rail} />
  <Gate slot="overlay" />
</BaseLayout>

<script>
  import { initHome } from '../scripts/home/init-home';

  void initHome();
</script>
