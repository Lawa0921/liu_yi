---
// 單一課程。版面順序（業主 2026-11-20）：首屏（名稱與一句話簡介＋右側一格）→ 內文 → 課程照片 → 外連影片 → 練什麼 → 授課教練 → 相關連結。
// 內文可能只有兩三句（等業主補文案），版型不能靠內文撐高度。首屏右側那一格：
//   有站內影片（course.data.video）就放影片：一開始蓋著封面（video.cover 的圖，沒有就是分類字牌），點了在原地播；頁面下方不再另外放影片區；
//   否則有照片就放照片（可用按鈕切換）；都沒有就放字牌（分類單字＋紋樣，CoursePlate.astro），不放任何替代圖。
// 有影片的課，照片移到內文下方的「課程照片」區；cardOnly 的照片（課程卡專用的影片截圖）內頁不顯示。
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoachCard from '../../components/CoachCard.astro';
import CourseGallery from '../../components/CourseGallery.astro';
import CoursePlate from '../../components/CoursePlate.astro';
import Plaque from '../../components/Plaque.astro';
import VideoSection from '../../components/VideoSection.astro';
import Weapon from '../../components/ornament/Weapon.astro';
import { coachesOfCourse, getPublishedCoaches, getPublishedCourses, type Course } from '../../lib/content';
import { AUDIENCE_LABEL, CATEGORY_GLYPH, CATEGORY_LABEL, pagePhotos } from '../../lib/courses';
import { sceneForCourse } from '../../lib/scene/config';
import { BOOKING_ANCHOR, BOOKING_LABEL } from '../../lib/site';
import { url } from '../../lib/url';
import { heroCover } from '../../lib/video';

export async function getStaticPaths() {
  const courses = await getPublishedCourses();
  return courses.map((course) => ({ params: { slug: course.id }, props: { course } }));
}

interface Props {
  course: Course;
}

const { course } = Astro.props;
const { title, summary, photos, subItems, video, videoUrl, category, audience } = course.data;
const { Content } = await render(course);
const coaches = coachesOfCourse(course, await getPublishedCoaches());
const glyph = category === 'other' ? undefined : CATEGORY_GLYPH[category];
const shownPhotos = pagePhotos(photos);
// 影片畫格的 poster：沒有 JS 時，以及點了封面之後、影片開始播放之前顯示（有 JS 時不是首屏內容，不預先載入）。
const poster = video ? await getImage({ src: video.poster, width: Math.min(video.width, 1280), format: 'webp' }) : undefined;
const cover = heroCover(video);

// 子項名稱 → 對應的兵器（只有這三種有；其他名稱就不畫）。
// 每個子項是一件可轉動的 3D 兵器（設計文件 §15.2-4；src/scripts/weapons3d.ts），線稿是沒有 WebGL／沒有 JS 時的退路。
const WEAPON_KIND: Record<string, 'jian' | 'miaodao' | 'spear'> = { 中國劍: 'jian', 苗刀: 'miaodao', 大槍: 'spear' };
---

<BaseLayout title={title} description={`${title}：${summary}`} ogImage={photos[0]?.src} ogType="article" scene={{ kind: 'course', spec: sceneForCourse({ id: course.id, category, audience }) }}>
  <article class="course">
    <header class="course-head">
      <div class="course-head__text">
        <p class="course-head__label">
          {
            glyph && (
              <span class="seal">
                <span>{glyph}</span>
              </span>
            )
          }
          <span>{category === 'other' ? '其他課程' : CATEGORY_LABEL[category]}</span>
          {audience !== 'all' && <span class="course-head__audience">{AUDIENCE_LABEL[audience]}</span>}
        </p>
        <h1 class="course-head__title">{title}</h1>
        <span class="rule course-head__rule" aria-hidden="true"></span>
        <p class="lead">{summary}</p>
        <p class="course-head__cta">
          <a class="button button--solid" href={BOOKING_ANCHOR} data-line-open>{BOOKING_LABEL}</a>
        </p>
      </div>

      {
        video ? (
          /* 原生播放器：按下播放前只載 poster、不載影片位元組。格子沿用照片格的 4:3，影片用 contain 置中（方形、直式不裁切），留暗色邊。
             有 JS 時一開始蓋著封面（video.cover 的圖，沒有就是分類字牌），影片本身隱藏（不會先閃 poster 畫格）；
             點封面任何位置或播放鈕才換成影片並開始播放（src/scripts/hero-video.ts）。沒有 JS 時沒有封面，就是原生 video＋poster。 */
          <div class="course-head__video cornered" data-hero-video>
            <i class="cornered__tick" />
            <i class="cornered__tick" />
            <i class="cornered__tick" />
            <i class="cornered__tick" />
            <video
              class="course-head__player"
              src={url(video.src)}
              poster={poster?.src}
              width={video.width}
              height={video.height}
              controls
              playsinline
              preload="none"
              aria-label={`${title}課程影片`}
            />
            {/* 整個封面可點（腳本把點擊接在這個 div 上），但唯一可聚焦的是裡面的播放鈕，不巢狀互動元素。 */}
            <div class="course-head__cover" data-hero-cover data-requires-js>
              {cover?.kind === 'image' ? (
                <Image
                  class="course-head__cover-image"
                  src={cover.src}
                  alt=""
                  width={1200}
                  height={900}
                  fit="cover"
                  sizes="(min-width: 60rem) 42rem, 95vw"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <CoursePlate class="course-head__cover-plate" category={category} glyph={glyph ?? ''} />
              )}
              {/* 播放鈕：視覺同課程卡的「影片」鈕、放大。 */}
              <button class="course-head__play" type="button" aria-label={`播放${title}課程影片`} data-hero-play>
                <svg class="course-head__play-icon" viewBox="0 0 12 14" width="18" height="21" aria-hidden="true">
                  <path d="M1 1L11 7L1 13Z" fill="currentColor" />
                </svg>
                <span aria-hidden="true">影片</span>
              </button>
            </div>
          </div>
        ) : shownPhotos.length > 0 ? (
          <CourseGallery class="course-head__media" photos={shownPhotos} courseTitle={title} eager />
        ) : (
          glyph && <CoursePlate class="course-head__plate" category={category} glyph={glyph} framed />
        )
      }
    </header>

    <section class="section section--tight">
      <div class="container course-body">
        <div class="prose" data-course-body>
          <Content />
        </div>
      </div>
    </section>

    {
      video && shownPhotos.length > 0 && (
        <section class="section section--tight" aria-labelledby="photos-heading" data-course-photos>
          <div class="container">
            <Plaque id="photos-heading">課程照片</Plaque>
            <CourseGallery class="course-photos__gallery" photos={shownPhotos} courseTitle={title} />
          </div>
        </section>
      )
    }

    {/* 只有外連影片（videoUrl，例如 YouTube）的課才會輸出；站內影片已經在首屏。 */}
    {!video && <VideoSection videoUrl={videoUrl} courseTitle={title} />}

    {
      subItems.length > 0 && (
        <section class="section section--tight" aria-labelledby="sub-items-heading">
          <div class="container" data-weapon3d-scope>
            <Plaque id="sub-items-heading">練什麼</Plaque>
            <p class="sub-items__hint" data-weapon3d-controls>拖曳轉動</p>
            <ul class="sub-items" data-sub-items>
              {subItems.map((item, index) => (
                <li class="sub-item cornered" data-reveal style={`--reveal-i:${index}`}>
                  <i class="cornered__tick" />
                  <i class="cornered__tick" />
                  <i class="cornered__tick" />
                  <i class="cornered__tick" />
                  {WEAPON_KIND[item.name] && (
                    <span class="sub-item__weapon" data-weapon3d="single" data-weapon-kind={WEAPON_KIND[item.name]}>
                      <Weapon kind={WEAPON_KIND[item.name]!} class="weapon3d-fallback" />
                    </span>
                  )}
                  <h3 class="sub-item__name">{item.name}</h3>
                  {item.description && <p class="sub-item__text">{item.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      coaches.length > 0 && (
        <section class="section section--tight" aria-labelledby="coach-heading">
          <div class="container">
            <Plaque id="coach-heading">授課教練</Plaque>
            <ul class="course-coaches">
              {coaches.map((coach) => (
                <li data-reveal>
                  <CoachCard coach={coach} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <footer class="section section--tight">
      <div class="container">
        <span class="hairline" aria-hidden="true" />
        <ul class="course-links">
          <li><a class="button button--solid" href={BOOKING_ANCHOR} data-line-open>{BOOKING_LABEL}</a></li>
          <li><a class="button" href={url('/schedule/')}>課表</a></li>
          <li><a class="button" href={url('/courses/')}>返回課程總覽</a></li>
        </ul>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* ── 首屏 ─────────────────────────────────────────── */
  .course-head {
    display: grid;
    gap: var(--space-6);
    align-items: center;
    width: min(100% - 2 * var(--gutter), var(--page-width));
    margin-inline: auto;
    padding-block: clamp(var(--space-6), 6vw, var(--space-8)) var(--space-6);
  }

  .course-head__label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.4em;
  }

  .course-head__label .seal {
    font-size: 0.95rem;
  }

  .course-head__audience {
    padding-inline-start: var(--space-3);
    border-inline-start: var(--line) solid var(--color-line);
    color: var(--color-text-muted);
  }

  .course-head__title {
    margin-bottom: var(--space-5);
    font-size: clamp(3rem, 2rem + 5.5vw, 6rem);
    line-height: 1.1;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .course-head__rule {
    width: min(100%, 15.75rem);
    margin-bottom: var(--space-5);
  }

  .course-head__cta {
    margin: var(--space-6) 0 0;
  }

  /* 照片（沒有影片的課）：照片切換區本身的樣式在 CourseGallery.astro。 */

  /* 影片（有站內影片的課）：外框與照片格同為 4:3、同樣的角飾與細框；影片 contain 置中，四周是暗色邊。
     高度另外不超過一屏可見高度（扣掉頁首與底欄），矮視窗下格子變扁、影片照樣完整。 */
  .course-head__video {
    min-width: 0;
    aspect-ratio: 4 / 3;
    max-height: calc(var(--stage-height) - var(--space-6));
    border: var(--line) solid var(--color-line-faint);
    background: var(--color-deep);
  }

  .course-head__player {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: transparent;
  }

  /* 封面：有 JS 時從第一次繪製就蓋住影片格（html.js 是 <head> 行內腳本在首繪前加的），影片本身隱藏，看不到 poster 畫格、也 Tab 不到；
     點了之後腳本在影片格加 data-hero-started：封面收起、影片出現，之後用原生控制列。沒有 JS 時封面 display:none（data-requires-js）。 */
  .course-head__cover {
    /* 播放鈕的高度與離右、下緣的距離（手機），桌機在下方 media query 放大。 */
    --hero-play-h: 2.75rem;
    --hero-play-inset: var(--space-4);
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    cursor: pointer;
    /* 讓字牌大字能依封面高度讓位給左上角的播放鈕（cqh）。 */
    container-type: size;
  }

  /* 字牌封面的大字：與獨立字牌同一個大小；只有封面太矮、會壓到左上角播放鈕時才縮小
     （上下各留出播放鈕高度＋間距，大字置中，所以上緣一定在播放鈕下緣之下）。 */
  .course-head__cover :global(.course-plate__glyph) {
    font-size: min(clamp(9rem, 24vw, 17rem), 100cqh - 2 * (var(--hero-play-h) + var(--hero-play-inset) + 4px));
  }

  @media (min-width: 48rem) {
    .course-head__cover {
      --hero-play-h: 4rem;
      --hero-play-inset: var(--space-5);
    }
  }

  :global(html.js) .course-head__video:not([data-hero-started]) .course-head__player {
    visibility: hidden;
  }

  .course-head__video[data-hero-started] .course-head__cover {
    display: none;
  }

  /* 字牌封面與封面圖都填滿影片格（字牌與獨立字牌同為 4:3，比例一致）。 */
  .course-head__cover :global(.course-head__cover-plate),
  .course-head__cover :global(.course-head__cover-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .course-head__cover :global(.course-head__cover-image) {
    object-fit: cover;
  }

  /* 封面左上角的播放鈕（不壓到中央的大字）：與課程卡的「影片」鈕同一套樣子（CourseCard.astro 的 .course-card__play）；
     手機與課程卡同大小，桌機放大。放左上而不是右下：桌機首屏時封面下緣在視窗外、又被固定底欄蓋住，右下角看不到。 */
  .course-head__play {
    position: absolute;
    left: var(--hero-play-inset);
    top: var(--hero-play-inset);
    z-index: 3;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: var(--hero-play-h);
    height: var(--hero-play-h);
    padding: 0 var(--space-3) 0 var(--space-4);
    border: var(--line) solid var(--color-line);
    background: var(--color-veil);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.28em;
    line-height: 1;
    cursor: pointer;
    transition:
      color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  .course-head__play-icon {
    width: 0.75rem;
    height: auto;
  }

  @media (min-width: 48rem) {
    .course-head__play {
      gap: var(--space-3);
      padding: 0 var(--space-5) 0 var(--space-6);
      font-size: var(--text-lg);
    }

    .course-head__play-icon {
      width: 1.125rem;
    }
  }

  /* hover／focus：金色由左鋪滿（與站上 .button、課程卡播放鈕同一個語彙）。 */
  .course-head__play::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s var(--ease-out);
  }

  .course-head__play:hover,
  .course-head__play:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .course-head__play:hover::before,
  .course-head__play:focus-visible::before {
    transform: scaleX(1);
  }

  .course-head__play-icon {
    flex: none;
  }

  /* 有影片的課，照片移到內文下方的照片區：限制寬度，標題＋照片＋切換鈕在桌機一屏內看得完。 */
  :global(.course-photos__gallery) {
    max-width: 40rem;
    margin-inline: auto;
  }

  /* 字牌（沒有影片也沒有照片的課程）：樣式在 CoursePlate.astro。 */

  @media (min-width: 60rem) {
    .course-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-8);
      min-height: min(calc(var(--stage-height) - var(--space-7)), 44rem);
    }
  }

  /* 進場：標題由左、照片或字牌擦出。 */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .course-head__text > * {
      animation: course-head-in 0.9s var(--ease-out) both;
    }

    :global(html.js) .course-head__text > :nth-child(2) {
      animation-delay: 0.1s;
    }

    :global(html.js) .course-head__text > :nth-child(3) {
      animation-delay: 0.2s;
    }

    :global(html.js) .course-head__text > :nth-child(4) {
      animation-delay: 0.3s;
    }

    :global(html.js) .course-head__text > :nth-child(5) {
      animation-delay: 0.4s;
    }

    :global(html.js .course-head__media),
    :global(html.js) .course-head__video,
    :global(html.js .course-head__plate) {
      animation: course-media-in 1.1s var(--ease-out) 0.15s both;
    }
  }

  @keyframes course-head-in {
    from {
      opacity: 0;
      transform: translate3d(-1.5rem, 0, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes course-media-in {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ── 內文 ─────────────────────────────────────────── */
  .course-body {
    display: grid;
    justify-items: center;
  }

  .course-body .prose {
    width: 100%;
  }

  /* 第一段是帶氣氛的一句話：放大、襯線、左側一道金線。 */
  .course-body .prose > :global(p:first-child) {
    margin-bottom: var(--space-6);
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: 0.12em;
    line-height: 1.7;
  }

  .course-body .prose :global(p),
  .course-body .prose :global(li) {
    color: var(--color-text-muted);
  }

  .course-body .prose :global(strong) {
    color: var(--color-text);
  }

  /* 內文照片（Markdown 圖片，例如中式兵器：課程卡保留 3D 兵器，所以照片不放 photos）。 */
  .course-body .prose :global(img) {
    display: block;
    width: 100%;
    max-width: 36rem;
    height: auto;
    border: var(--line) solid var(--color-line-faint);
  }

  .course-body .prose :global(p:has(> img)) {
    margin-block: var(--space-6);
  }

  .course-body .prose :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-text);
    letter-spacing: 0.2em;
  }

  .course-body .prose :global(h2)::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-line), transparent);
  }

  .course-body .prose :global(h3) {
    color: var(--color-accent-strong);
    letter-spacing: 0.16em;
  }

  .course-body .prose :global(ul) {
    padding: 0;
    list-style: none;
  }

  .course-body .prose :global(li) {
    position: relative;
    padding-inline-start: 1.4em;
  }

  .course-body .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .course-body .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.72em;
    width: 0.4em;
    height: 0.4em;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  /* ── 子項：一列一件，像兵器架。名稱與兵器各佔一格（兵器不壓到名稱）；
        兵器是 3D（沒有 WebGL／JS 時是線稿），整件裝在自己的那一格裡 ── */
  .sub-items {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sub-items__hint {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.3em;
    text-align: center;
  }

  .sub-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--line) solid var(--color-line-faint);
    background: radial-gradient(ellipse at 60% 50%, var(--color-surface-raised), var(--color-surface) 70%);
  }

  .sub-item__name {
    grid-row: 1;
    margin: 0;
    font-size: clamp(1.5rem, 6vw, 2.75rem);
    letter-spacing: 0.3em;
    white-space: nowrap;
  }

  /* 兵器自己的一格（畫布與線稿都在這裡面）。手機：名稱在上、兵器在下，給它一塊近乎方形的空間斜放。 */
  .sub-item__weapon {
    grid-row: 2;
    position: relative;
    height: min(100vw, 26rem);
