---
// 課程總覽：大人／小孩切換 × 三分類，下方「其他課程」。
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceCards from '../../components/AudienceCards.astro';
import CourseCard from '../../components/CourseCard.astro';
import Plaque from '../../components/Plaque.astro';
import { getPublishedCourses } from '../../lib/content';
import { otherCourses } from '../../lib/courses';
import { Image } from 'astro:assets';
import { PAGE_SCENES, sceneForCourse } from '../../lib/scene/config';
import { BOOKING_ANCHOR } from '../../lib/site';
import lecture1 from '../../assets/images/outreach_lecture_1.jpg';
import lecture3 from '../../assets/images/outreach_lecture_3.jpg';

const courses = await getPublishedCourses();
// 外派與機構合作：文案改寫自粉專 2026-11 的機構講座與社區親子防身課貼文（docs/fb-sync-2026-11-18.md）。
const outreachPhotos = [
  { src: lecture1, alt: '防身講座現場：學員站在教室裡，前方的人在講解' },
  { src: lecture3, alt: '防身講座現場：前方的人示範動作，學員站在桌旁觀看' },
];
const others = otherCourses(courses);
// 頁首的剪影場景（Task 27）：預設是站樁的人物；滑過或聚焦課程卡時換成該課的剪影（卡片的 data-scene-card），所以把每門課的人物都放進場景。
const scene = {
  kind: 'courses',
  spec: PAGE_SCENES.courses,
  swap: courses.map((course) => sceneForCourse({ id: course.id, ...course.data }).subject.asset),
};
---

<BaseLayout title="課程" description="六藝武術工作室的課程：大人與小孩各有兵器、拳術、格鬥三門課，另有巴西柔術與核心瑜珈。" scene={scene}>
  <section class="section section--flush-top" aria-labelledby="page-title">
    <div class="container">
      <div class="page-head">
        <Plaque as="h1" id="page-title" size="page" reveal={false}>課程</Plaque>
        <p class="lead">兵器、拳術、格鬥，大人和小孩各一門。</p>
      </div>
      <h2 class="visually-hidden">兵器、拳術、格鬥</h2>
      <AudienceCards courses={courses} />
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section section--flush-top" aria-labelledby="other-heading">
        <div class="container">
          <Plaque id="other-heading">其他課程</Plaque>
          <ul class="other-grid">
            {others.map((course, index) => (
              <li data-reveal style={`--reveal-i:${index}`}>
                <CourseCard course={course} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--flush-top" aria-labelledby="outreach-heading">
    <div class="container">
      <Plaque id="outreach-heading">外派與機構合作</Plaque>
      <div class="outreach">
        <div class="outreach__text" data-reveal>
          <p>
            除了日常武術課程，我們也持續拓展不同形式的教學服務，包含專題講座、職場防身課程及機構合作活動。機構、學校、企業或團體若有防身教育與安全課程的需求，歡迎與我們聯繫。
          </p>
          <p>近期合作：詹教練受邀擔任暖暖社會工作師事務所防身專題講座講師，為社工人員規劃單日防身課程；猴子老師應城男舊事心驛站邀約，到加蚋錦德社區發展協會分享親子防身。</p>
          <h3>可規劃的合作形式</h3>
          <ul>
            <li>安親班、幼兒園的常態武術防身課</li>
            <li>親子館單日講座</li>
            <li>親子共學團、家長自主團的短期主題活動</li>
            <li>專題講座、職場防身課程及機構合作活動</li>
          </ul>
          <p><a class="button" href={BOOKING_ANCHOR} data-line-open>用 LINE 洽談合作</a></p>
        </div>
        <ul class="outreach__photos">
          {
            outreachPhotos.map((photo, index) => (
              <li class="cornered">
                <i class="cornered__tick" />
                <i class="cornered__tick" />
                <i class="cornered__tick" />
                <i class="cornered__tick" />
                <div data-reveal="wipe" style={`--reveal-i:${index}`}>
                  <Image src={photo.src} alt={photo.alt} width={900} height={675} fit="cover" sizes="(min-width: 60rem) 26rem, 95vw" loading="lazy" />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .outreach {
    display: grid;
    gap: var(--space-6);
  }

  .outreach__text {
    color: var(--color-text-muted);
  }

  .outreach__text h3 {
    margin: var(--space-5) 0 var(--space-3);
    color: var(--color-text);
    font-size: var(--text-lg);
  }

  .outreach__text ul {
    margin: 0 0 var(--space-5);
    padding-left: 1.2em;
  }

  .outreach__photos {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outreach__photos li {
    border: var(--line) solid var(--color-line-faint);
  }

  .outreach__photos :global(img) {
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .outreach {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: var(--space-8);
    }
  }

  .other-grid {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .other-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
</style>
