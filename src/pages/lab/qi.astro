---
// 試作「氣聚成人」（方向 C）：拋棄式的首頁方向試作，給業主看感覺用。不進 sitemap、不給搜尋引擎收錄。
// 程式在 src/lab/qi/。
import { Font } from 'astro:assets';
import lift from '../../assets/silhouettes/fig-zhenjiao.png';
import landPose from '../../assets/silhouettes/fig-zhenjiao-land.png';
import dingzhou from '../../assets/silhouettes/fig-dingzhou.png';
import chengchui from '../../assets/silhouettes/fig-chengchui.png';
import kao from '../../assets/silhouettes/fig-kao.png';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';

const figures = {
  lift: lift.src,
  land: landPose.src,
  dingzhou: dingzhou.src,
  chengchui: chengchui.src,
  kao: kao.src,
};

const moves = [
  { no: '第一式', name: '震腳', lines: ['一腳踏地，勁從腳底起。', '八極的每一下，都從這一震開始。'] },
  { no: '第二式', name: '頂肘', lines: ['步到身到，肘走中線。', '貼近一寸，整個人一起撞進去。'] },
  { no: '第三式', name: '撐捶', lines: ['兩臂一撐，前打後撐。', '力往兩頭走，中間不散。'] },
  { no: '第四式', name: '貼山靠', lines: ['以肩背靠人。', '近到出不了拳，身體就是拳頭。'] },
  { no: '兵器', name: '劍', lines: ['雙刃直身，輕靈直進。'] },
  { no: '兵器', name: '苗刀', lines: ['雙手長刀，劈砍連環。'] },
  { no: '兵器', name: '大槍', lines: ['白蠟長桿，百兵之王。'] },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>氣聚成人（試作）｜{SITE.shortName}</title>
    <meta name="theme-color" content="#0b0a09" />
    <Font cssVariable="--font-twkai" />
  </head>
  <body>
    <canvas class="qi-canvas" aria-hidden="true"></canvas>
    <main class="qi" data-qi data-figures={JSON.stringify(figures)}>
      <section class="qi-step qi-step--hero" data-step="0">
        <div class="qi-hero">
          <h1 class="qi-title">{SITE.shortName}</h1>
          <p class="qi-sub">八極拳　兵器　格鬥</p>
        </div>
        <p class="qi-hint" aria-hidden="true">往下捲</p>
      </section>
      {
        moves.map((move, i) => (
          <section class="qi-step" data-step={i + 1}>
            <div class="qi-caption">
              <p class="qi-no">
                <span class="qi-seal" aria-hidden="true" />
                {move.no}
              </p>
              <h2 class="qi-name">{move.name}</h2>
              <div class="qi-lines">
                {move.lines.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </div>
            {i === moves.length - 1 && (
              <a class="qi-next" href={url('/')}>
                看真兵器
              </a>
            )}
          </section>
        ))
      }
    </main>

    <script>
      import { initQi } from '../../lab/qi/main';
      void initQi();
    </script>

    <style is:global>
      :root {
        --qi-bg: #0b0a09;
        --qi-gold: #b3924f;
        --qi-paper: #f1e3c6;
        --qi-muted: #c9bda3;
        --qi-seal: #b3261e;
        scroll-snap-type: y mandatory;
        background: var(--qi-bg);
      }

      body {
        margin: 0;
        background: var(--qi-bg);
        color: var(--qi-paper);
        font-family: var(--font-twkai), serif;
        font-synthesis: none;
        -webkit-font-smoothing: antialiased;
      }

      .qi-canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: block;
      }

      .qi {
        position: relative;
      }

      .qi-step {
        position: relative;
        box-sizing: border-box;
        min-height: 100vh;
        display: flex;
        align-items: center;
        padding: 0 0 0 max(6vw, 2rem);
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      .qi-hero,
      .qi-caption {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        gap: 1.4rem;
        opacity: 0;
        transform: translateY(1.2rem);
        transition:
          opacity 0.9s ease,
          transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
      }

      .qi.is-awake .qi-step.is-active .qi-hero,
      .qi.is-awake .qi-step.is-active .qi-caption {
        opacity: 1;
        transform: none;
        transition-delay: 0.35s;
      }

      .qi-title,
      .qi-name {
        margin: 0;
        writing-mode: vertical-rl;
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.22em;
        color: var(--qi-paper);
        text-shadow: 0 0 24px rgba(11, 10, 9, 0.9);
      }

      .qi-title {
        font-size: clamp(3.4rem, 8vh, 6.2rem);
      }

      .qi-name {
        font-size: clamp(3rem, 7.5vh, 5.4rem);
      }

      .qi-sub,
      .qi-lines p,
      .qi-no {
        margin: 0;
        writing-mode: vertical-rl;
        letter-spacing: 0.3em;
        font-size: clamp(0.95rem, 2vh, 1.15rem);
        line-height: 1.9;
        color: var(--qi-muted);
      }

      .qi-lines {
        display: flex;
        flex-direction: row-reverse;
        gap: 0.2rem;
        padding-top: 4.2rem;
      }

      .qi-sub {
        padding-top: 0.4rem;
        color: var(--qi-gold);
      }

      .qi-no {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--qi-gold);
      }

      .qi-seal {
        display: block;
        width: 0.7rem;
        height: 0.7rem;
        background: var(--qi-seal);
      }

      .qi-hint {
        position: absolute;
        left: 50%;
        bottom: 1.6rem;
        margin: 0;
        transform: translateX(-50%);
        font-size: 0.85rem;
        letter-spacing: 0.4em;
        color: var(--qi-gold);
        opacity: 0;
        transition: opacity 1s ease 1.2s;
      }

      .qi.is-awake .qi-step--hero.is-active .qi-hint {
        opacity: 0.8;
      }

      .qi-next {
        position: absolute;
        right: max(6vw, 1.5rem);
        bottom: 2.2rem;
        padding: 0.7rem 1.4rem;
        border: 1px solid rgba(179, 146, 79, 0.6);
        color: var(--qi-paper);
        text-decoration: none;
        letter-spacing: 0.3em;
        font-size: 0.95rem;
      }

      .qi-next:hover,
      .qi-next:focus-visible {
        border-color: var(--qi-paper);
      }

      /* 沒有 WebGL：只留文字。 */
      .qi.is-static .qi-hero,
      .qi.is-static .qi-caption {
        opacity: 1;
        transform: none;
      }

      @media (max-aspect-ratio: 1/1) {
        .qi-step {
          align-items: flex-end;
          padding: 0 1.25rem 9vh;
        }

        .qi-title {
          font-size: clamp(2.6rem, 6.5vh, 3.6rem);
        }

        .qi-name {
          font-size: clamp(2.2rem, 5.5vh, 3rem);
        }

        .qi-lines {
          padding-top: 2.6rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .qi-hero,
        .qi-caption,
        .qi-hint {
          transition: none;
        }
      }
    </style>
  </body>
</html>
