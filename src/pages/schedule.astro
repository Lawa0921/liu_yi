---
// 課表：這一版照用海報（設計文件 §7），時間不轉成文字，避免抄錯。
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterFigure from '../components/PosterFigure.astro';
import Plaque from '../components/Plaque.astro';
import schedule from '../assets/images/schedule.png';
import { BOOKING_ANCHOR } from '../lib/site';
---

<BaseLayout title="課表" description="六藝武術工作室的常態班課表。" ogImage={schedule}>
  <section class="section section--flush-top" aria-labelledby="page-title">
    <div class="container">
      <div class="page-head">
        <Plaque as="h1" id="page-title" size="page" reveal={false}>課表</Plaque>
        <p class="lead">
          常態班課表請見下方海報；想確認時段或預約，歡迎<a href={BOOKING_ANCHOR} data-line-open>用 LINE 詢問</a>。
        </p>
      </div>
      <div class="schedule-poster">
        <PosterFigure src={schedule} alt="常態班課表海報。詳細內容請見圖片或洽 LINE。" caption="常態班課表" eager />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .schedule-poster {
    display: grid;
    justify-items: center;
  }

  .schedule-poster :global(.poster) {
    max-width: 44rem;
  }
</style>
