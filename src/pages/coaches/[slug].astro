---
// 單一教練：姓名、職稱、海報、資歷（只列海報上有的）、授課課程。
// 教練海報只用在這一頁（設計文件 §8）。光點層（Task 26）：抱拳（salute）的光點人形。
import BaseLayout from '../../layouts/BaseLayout.astro';
import PosterFigure from '../../components/PosterFigure.astro';
import { getPublishedCoaches, getPublishedCourses, type Coach } from '../../lib/content';
import { coursesOfCoach } from '../../lib/courses';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const coaches = await getPublishedCoaches();
  return coaches.map((coach) => ({ params: { slug: coach.id }, props: { coach } }));
}

interface Props {
  coach: Coach;
}

const { coach } = Astro.props;
const { name, role, poster, posterAlt, credentials } = coach.data;
const courses = coursesOfCoach(await getPublishedCourses(), coach.id);
const courseNames = courses.map((course) => course.data.title).join('、');
---

<BaseLayout
  title={`${name}｜${role}`}
  description={courseNames ? `${name}（${role}），教授${courseNames}。` : `${name}（${role}）。`}
  ogType="article"
  qi="coach"
>
  <article class="section section--flush-top">
    <div class="container coach">
      <div class="coach__text">
        <p class="coach__role">{role}</p>
        <h1 class="coach__name">{name}</h1>
        <span class="rule coach__rule" aria-hidden="true"></span>

        {
          courses.length > 0 && (
            <section class="coach__block" aria-labelledby="coach-courses">
              <h2 id="coach-courses">授課課程</h2>
              <ul class="coach__courses">
                {courses.map((course) => (
                  <li>
                    <a class="button" href={url(`/courses/${course.id}/`)}>
                      {course.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          credentials.map((group) => (
            <section class="coach__block coach__credentials" data-reveal>
              <h2>{group.heading}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }

        <p class="coach__back"><a class="text-link" href={url('/coaches/')}>返回師資總覽</a></p>
      </div>

      {
        poster && posterAlt && (
          <div class="coach__poster">
            <PosterFigure src={poster} alt={posterAlt} caption={`${name}介紹海報`} eager />
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .coach {
    display: grid;
    gap: var(--space-7);
    align-items: start;
    padding-top: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .coach__role {
    margin: 0 0 var(--space-3);
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: 0.4em;
  }

  .coach__name {
    margin-bottom: var(--space-5);
    font-size: clamp(3rem, 2rem + 5.5vw, 6rem);
    line-height: 1.1;
    letter-spacing: 0.12em;
  }

  .coach__rule {
    width: min(100%, 15.75rem);
  }

  .coach__block {
    margin-top: var(--space-7);
  }

  .coach__block h2 {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-size: var(--text-xl);
    letter-spacing: 0.3em;
  }

  .coach__block h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-line), transparent);
  }

  .coach__courses {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coach__credentials ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .coach__credentials li {
    position: relative;
    padding: var(--space-3) 0 var(--space-3) 1.5em;
    border-bottom: var(--line) solid var(--color-border-subtle);
    color: var(--color-text-muted);
  }

  .coach__credentials li::before {
    content: '';
    position: absolute;
    left: 0.2em;
    top: 1.45em;
    width: 0.4em;
    height: 0.4em;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  .coach__back {
    margin: var(--space-7) 0 0;
  }

  .coach__poster {
    display: grid;
    justify-items: center;
  }

  @media (min-width: 60rem) {
    .coach {
      grid-template-columns: minmax(0, 1fr) minmax(0, 27rem);
      gap: var(--space-8);
    }

    .coach__poster {
      position: sticky;
      top: calc(var(--frame-top) + var(--space-6));
    }
  }
</style>
